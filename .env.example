JWT_SECRET="medbook-super-secret-key-12345!"

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Connect to Supabase via connection pooling with Supavisor (Port 6543)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct connection to the database. Used for migrations (Port 5432)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Google Gemini API key for AI Assistant doctor recommendations
GEMINI_API_KEY="your-gemini-api-key-here"
